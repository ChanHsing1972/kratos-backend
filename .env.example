# Agent backend example environment variables
# Copy this file to .env and fill with real values

PROJECT_NAME=Kratos Agent Backend
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

PG_USER=postgres
PG_PASSWORD=
PG_SERVER=127.0.0.1
PG_PORT=5432
PG_DB=kratos_db

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600000

ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
# Leave empty for local ./uploads. Deployment injects a shared absolute path.
UPLOAD_STORAGE_DIR=

# Agent LLM
AGENT_LLM_BASE_URL=http://127.0.0.1:4141
AGENT_LLM_MODEL=gpt-4.1
AGENT_LLM_API_KEY=EMPTY
AGENT_LLM_TEMPERATURE=0.5
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_SSL_VERIFY=true
AGENT_STREAM_CHUNK_CHARS=18
AGENT_STREAM_CHUNK_DELAY_SECONDS=0.055
AGENT_STREAM_FINAL_EVENT_DELAY_SECONDS=0.35

# Food image vision
FOOD_VISION_API_KEY=
FOOD_VISION_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
FOOD_VISION_MODEL=
FOOD_VISION_TIMEOUT_SECONDS=25
FOOD_VISION_MAX_RETRIES=0
FOOD_VISION_MAX_OUTPUT_TOKENS=900

# Search tool
TAVILY_API_KEY=

# Memory retention
SHORT_TERM_MEMORY_MAX_COUNT=40
SHORT_TERM_MEMORY_RETENTION_DAYS=14
WORKING_MEMORY_MAX_COUNT=12
WORKING_MEMORY_RETENTION_HOURS=48

# MuscleWiki API
MUSCLEWIKI_API_BASE_URL=https://api.musclewiki.com
MUSCLEWIKI_API_KEY=
MUSCLEWIKI_TIMEOUT_SECONDS=30

# Spoonacular API
SPOONACULAR_API_BASE_URL=https://api.spoonacular.com
SPOONACULAR_API_KEY=
SPOONACULAR_TIMEOUT_SECONDS=30

# QWeather / HeWeather API
HEWEATHER_API_BASE_URL=https://api.qweather.com
HEWEATHER_API_KEY=
HEWEATHER_TIMEOUT_SECONDS=30

# AMap Web Service API
AMAP_WEB_API_BASE_URL=https://restapi.amap.com
AMAP_WEB_API_KEY=
AMAP_WEB_API_TIMEOUT_SECONDS=30

# RapidAPI Exercise Database
RAPIDAPI_PORTAL_URL=https://rapidapi.com
RAPIDAPI_BASE_URL=https://edb-with-videos-and-images-by-ascendapi.p.rapidapi.com
RAPIDAPI_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_TIMEOUT_SECONDS=30
BILIBILI_SEARCH_TIMEOUT_SECONDS=10
BILIBILI_TEACHING_VIDEO_LIMIT=3
