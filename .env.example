# Agent backend example environment variables
# Copy this file to .env and fill with real values

PROJECT_NAME=Kratos Agent Backend
API_V1_STR=/api/v1

PG_USER=postgres
PG_PASSWORD=12345678
PG_SERVER=127.0.0.1
PG_PORT=5432
PG_DB=kratos_db

SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600000

# Agent LLM
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_MODEL=qwen-turbo
AGENT_LLM_API_KEY=
AGENT_LLM_TEMPERATURE=0.5

# Search tool
TAVILY_API_KEY=

# MuscleWiki API
MUSCLEWIKI_API_BASE_URL=https://api.musclewiki.com
MUSCLEWIKI_API_KEY=
MUSCLEWIKI_TIMEOUT_SECONDS=30

# Spoonacular API
SPOONACULAR_API_BASE_URL=https://api.spoonacular.com
SPOONACULAR_API_KEY=
SPOONACULAR_TIMEOUT_SECONDS=30

# QWeather / HeWeather API
HEWEATHER_API_BASE_URL=https://api.qweather.com
HEWEATHER_API_KEY=
HEWEATHER_TIMEOUT_SECONDS=30

# AMap Web Service API
AMAP_WEB_API_BASE_URL=https://restapi.amap.com
AMAP_WEB_API_KEY=
AMAP_WEB_API_TIMEOUT_SECONDS=30

